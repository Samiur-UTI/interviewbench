# Task scripts and container files run on Linux: keep LF even on Windows checkouts.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.toml      text eol=lf
# TypeScript/JavaScript task files are read by Node in Linux containers: LF everywhere.
*.ts        text eol=lf
*.mjs       text eol=lf
src/interviewbench/ui/static/** text eol=lf
tasks/backend/flight-search-aggregator/**/*.json  text eol=lf
tasks/backend/flight-search-aggregator/**/*.md    text eol=lf
tasks/frontend/campaign-console/**/*.json  text eol=lf
tasks/frontend/campaign-console/**/*.md    text eol=lf
