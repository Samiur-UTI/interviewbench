#!/bin/sh
# Refuse to push to main from this clone: every change reaches main through a pull request.
# GitHub enforces the same with the rulesets in .github/rulesets/ once they are active (see
# docs/MAINTAINING.md); this hook also covers a clone, or an AI agent, before that.
# Turn it on once per clone: git config core.hooksPath .githooks
#
# git passes one line per ref being pushed on stdin: <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push to main. Push a branch and open a pull request instead." >&2
    status=1
  fi
done
exit "$status"
